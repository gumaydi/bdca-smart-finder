# ==============================================================================
# BDCA Smart Finder (Wisuda) - Environment Variables Template
# ==============================================================================
# Salin file ini menjadi .env.local untuk pengembangan lokal, atau masukkan
# nilai variabel ini ke Settings > Environment Variables pada dashboard Vercel.
# ==============================================================================

# Supabase Project URL
# Format: https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key
# Aman digunakan di browser client untuk pembacaan data publik dan Supabase Realtime
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Supabase Service Role Key
# PERINGATAN KEAMANAN: HANYA digunakan di server/API routes untuk operasi berizin tinggi (check-in kehadiran).
# JANGAN PERNAH mengekspos kunci ini ke browser client atau melakukan commit ke Git repository!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Panel Authentication
# Password untuk panel manajemen denah kursi dan pratinjau struktur kursi
ADMIN_PASSWORD=your-super-secret-admin-password

# Distributed Rate Limiting (Opsional - Upstash Redis REST API)
# Digunakan untuk rate limiting multi-region Vercel Functions.
# Jika dibiarkan kosong, sistem otomatis beralih ke sliding-window in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
